FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MIVA_PREVIEW_MODE=true

WORKDIR /app

COPY requirements-preview.txt .
RUN pip install --no-cache-dir -r requirements-preview.txt

COPY miva ./miva

EXPOSE 10000

CMD ["sh", "-c", "exec uvicorn miva.api.server:app --host 0.0.0.0 --port ${PORT:-10000}"]
