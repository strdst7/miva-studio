# MIVA Studio Environment Configuration
# Copy to .env and fill in values before running the pipeline.
# Never commit .env to version control.

# ── Vector Store ─────────────────────────────────────────────────────────────
MIVA_VECTOR_STORE_PROVIDER=qdrant           # qdrant | faiss | pinecone
MIVA_QDRANT_HOST=localhost
MIVA_QDRANT_PORT=6333
MIVA_QDRANT_COLLECTION=miva_anchors
# MIVA_QDRANT_API_KEY=                      # Required for Qdrant Cloud
# MIVA_PINECONE_API_KEY=                    # Required for Pinecone
# MIVA_PINECONE_ENVIRONMENT=us-east-1-aws

# ── Generation Model ─────────────────────────────────────────────────────────
MIVA_MODEL_ID=runwayml/stable-diffusion-v1-5
MIVA_IP_ADAPTER_MODEL=h94/IP-Adapter
MIVA_DEVICE=cpu                             # cpu | cuda | mps
MIVA_MODEL_CACHE_DIR=./model_cache

# ── Face Encoding ─────────────────────────────────────────────────────────────
MIVA_FACE_ENCODER=arcface                   # arcface | facenet
MIVA_ARCFACE_MODEL_PATH=./model_cache/arcface_r100.onnx
MIVA_FACE_DETECTION_THRESHOLD=0.5

# ── Guardrails ────────────────────────────────────────────────────────────────
MIVA_IDENTITY_THRESHOLD=0.75
MIVA_ARTIFACT_THRESHOLD=0.20
MIVA_MAX_REGENERATION_ATTEMPTS=3

# ── Observability ────────────────────────────────────────────────────────────
MIVA_TRACE_BACKEND=jsonl                    # jsonl | prometheus | otlp
MIVA_TRACE_OUTPUT_DIR=./traces
MIVA_METRICS_PORT=9090
MIVA_LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# ── API Server ────────────────────────────────────────────────────────────────
MIVA_API_HOST=0.0.0.0
MIVA_API_PORT=8000
MIVA_API_WORKERS=1

# ── Evaluation ────────────────────────────────────────────────────────────────
MIVA_EVAL_SEED=42
MIVA_EVAL_OUTPUT_DIR=./eval_outputs
